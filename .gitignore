# macOS
.DS_Store

# Xcode
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
# Package.resolved IS committed: Snitt ships as an app, so dependency
# versions are pinned so every machine and CI build resolves identically.

# Signing / secrets — never commit these
*.p12
*.mobileprovision
*.cer
.env
.env.*

# Task 4 (notarize.sh): App Store Connect API keys download as
# AuthKey_<KEYID>.p8 and are one of notarize.sh's two credential paths
# (NOTARY_KEY). Ignore both Apple's default filename shape and any .p8
# wherever it lands — nothing secret enters this repo.
AuthKey_*.p8
*.p8

# Task 5 (make-appcast.sh / Sparkle EdDSA signing): the maintainer's
# private key lives in the login Keychain by default (generate_keys), not
# a file — but generate_keys -x and sign_update --ed-key-file both accept
# an arbitrary file path if anyone ever exports one, e.g. for backup or
# transfer to another machine. There is no fixed filename Sparkle mandates
# for that export, so these patterns are a net, not a guarantee: never put
# an exported private key anywhere under this repo, even temporarily.
*.pem
*_private_key*
*private_key*
dsa_priv.pem
eddsa_priv*

# Snitt working artifacts
*.snitt/
*.mov
*.mp4
*.gif

# Scratch space for manual verification. macOS gates ~/Desktop behind the
# Files-and-Folders TCC service, so a shell cannot read the .snitt bundles
# Snitt writes there — copying one here is how you inspect it. Finder also
# refuses to copy into /tmp, which is why this lives in the repo.
/tmp/

# Release artifacts. The runbook builds both in the repo root: the ZIP is
# Sparkle's update enclosure, the DMG is the download for someone who has no
# copy yet. Neither belongs in git — they are outputs of a signed, notarized
# build that only exists on the maintainer's machine.
Snitt-*.zip
Snitt-*.dmg

# The appcast is the same kind of thing, and was tracked by accident rather
# than by decision — committed twice, incidentally, by releases that happened
# to notice it had changed. It is an OUTPUT of that signed build: it carries
# the EdDSA signature of the zip and the release URL, so a committed copy is
# stale the moment the next release is cut, and the copy Sparkle actually
# reads is the RELEASE ASSET (SUFeedURL points at
# releases/latest/download/appcast.xml), never this file. The feed is
# single-item, so nothing is lost by not keeping the history here — every
# past version's appcast is still attached to its own release.
#
# It also had a bite: tracked, it was left modified in the working tree after
# every release, and release.sh refuses a dirty tree — so cutting 0.3.0
# silently armed the NEXT release to fail preflight.
appcast.xml
